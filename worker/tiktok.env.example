# TikTok posting — example configuration ONLY. Placeholder values; never put
# real credentials in this file or in git.
#
# Set on the Worker deployment (Cloudflare dashboard or wrangler):
#   wrangler secret put TIKTOK_CLIENT_SECRET --config cloudflare/<config>
#   TIKTOK_CLIENT_KEY  as a secret or a plain var (it is not a password, but
#                      keep it with the secret for tidiness)
# Vars (cloudflare/wrangler.*.jsonc "vars" or dashboard):
#   TIKTOK_ENV=sandbox            # or production — informational; the client
#                                 # key/secret pair determines the environment
#   TIKTOK_REDIRECT_URI=https://one2onelove.com/api/tiktok/callback
#                                 # optional; this is the built-in default and
#                                 # MUST match the TikTok portal exactly
#                                 # (no trailing slash)
TIKTOK_CLIENT_KEY=your-client-key-here
TIKTOK_CLIENT_SECRET=your-client-secret-here
TIKTOK_ENV=sandbox
TIKTOK_REDIRECT_URI=https://one2onelove.com/api/tiktok/callback
