{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "one2onelove-scratch-integrated-preview",
  "main": "../worker/index-v2.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "NEON_AUTH_BASE_URL": "https://ep-shiny-truth-ar740o0s.neonauth.c-4.us-west-2.aws.neon.tech/one2onelove/auth",
    "STRIPE_PRICE_BASIC": "price_1UFUS7CoKDheG1ASULR2gdsn",
    "STRIPE_PRICE_PREMIERE": "price_1UFUSDCoKDheG1AS2AgFooh0",
    "STRIPE_PRICE_EXCLUSIVE": "price_1UFUSKCoKDheG1ASG5zk97Ph",
    "SCHEDULED_SMS_ENABLED": "false"
  },
  "hyperdrive": [{"binding":"HYPERDRIVE","id":"ef44564dbfca4e1bb13176ee568aaddf"}],
  "r2_buckets": [{"binding":"MEDIA","bucket_name":"one2onelove-media"}]
}
