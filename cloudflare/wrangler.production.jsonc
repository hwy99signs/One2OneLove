{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "one2onelove-launch",
  "main": "../worker/index-v2.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {"pattern": "one2onelove.com/*","zone_name": "one2onelove.com"},
    {"pattern": "www.one2onelove.com/*","zone_name": "one2onelove.com"}
  ],
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/studio-media/*", "/games-src/*", "/", "/Home", "/LoveNotes", "/DateIdeas", "/LGBTQSupport", "/CoupleSupport", "/PodcastsSupport", "/Professionals", "/O2OLStudio", "/PrivacyPolicy", "/TermsOfService", "/Suggestions"]
  },
  "vars": {
    "NEON_AUTH_BASE_URL": "https://ep-quiet-meadow-arq3q1vh.neonauth.c-4.us-west-2.aws.neon.tech/one2onelove/auth",
    "O2OL_PRELAUNCH_NO_OUTBOUND": "true",
    "STRIPE_PRICE_PREMIERE": "price_1UFUSDCoKDheG1AS2AgFooh0",
    "STRIPE_PRICE_EXCLUSIVE": "price_1UFUSKCoKDheG1ASG5zk97Ph",
    "SCHEDULED_SMS_ENABLED": "false",
    "ANALYTICS_BASELINE_AT": "2026-10-24T06:00:00.000Z",
    "PUBLIC_STATS_BASELINE_AT": "2026-10-12T12:27:00.000Z",
    "CLOUDFLARE_ZONE_ID": "449881ec0e315b87e822418a09714875",
    "O2OL_DEPLOYMENT_ENV": "prelaunch",
    "O2OL_DEPLOYMENT_ID": "o2ol-prelaunch-unified-20261030",
    "O2OL_EPSCIE_SITE_ENABLED": "false",
    "O2OL_EPSCIE_SITE_KEY_ID": "o2ol-site-health-20261013-v1"
  },
  "services": [
    {"binding":"EPSCIE_SERVICE","service":"epscie-core"}
  ],
  "hyperdrive": [{"binding": "HYPERDRIVE","id": "0a1440e83906496eac5ff276baca17ee"}],
  "triggers": {"crons": []},
  "r2_buckets": [
    {"binding": "MEDIA","bucket_name": "one2onelove-prelaunch-unified-20261030"},
    {"binding": "STUDIO_MEDIA","bucket_name": "one2onelove-media"}
  ]
}
