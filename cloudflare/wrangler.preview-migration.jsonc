{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "one2onelove-preview-migration",
  "main": "../worker/index-v2.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "NEON_AUTH_BASE_URL": "https://ep-shiny-truth-ar740o0s.neonauth.c-4.us-west-2.aws.neon.tech/one2onelove/auth"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "ef44564dbfca4e1bb13176ee568aaddf"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "one2onelove-media"
    }
  ]
}
