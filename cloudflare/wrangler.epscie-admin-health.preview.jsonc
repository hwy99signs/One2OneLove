{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "o2ol-admin-health-preview",
  "main": "../worker/epscie-admin-health-reporter.ts",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "vars": {
    "O2OL_MONITOR_ENV": "preview",
    "O2OL_EPSCIE_ADMIN_ENABLED": "false"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}