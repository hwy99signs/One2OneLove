{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "one2onelove-prelaunch",
  "main": "../worker/mmiq-prelaunch-preview.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/studio-media/*"]
  },
  "vars": {
    "NEON_AUTH_BASE_URL": "https://ep-royal-darkness-ars10dcl.neonauth.c-4.us-west-2.aws.neon.tech/one2onelove/auth",
    "PRELAUNCH_ENVIRONMENT": "true",
    "CLOUDFLARE_ZONE_ID": "449881ec0e315b87e822418a09714875"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "one2onelove-media"
    }
  ]
}
